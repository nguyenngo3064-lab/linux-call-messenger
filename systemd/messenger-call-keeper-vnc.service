[Unit]
Description=Loopback-only VNC access for Messenger Call Keeper login
After=messenger-call-keeper-xvfb.service
Requires=messenger-call-keeper-xvfb.service

[Service]
Type=simple
User=messenger-call-keeper
Group=messenger-call-keeper
Environment=HOME=/var/lib/messenger-call-keeper
ExecStart=/usr/bin/x11vnc -display :99 -localhost -nopw -forever -shared -rfbport 5900 -quiet
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
