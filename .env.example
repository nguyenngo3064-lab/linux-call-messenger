# Generate both secrets locally; never commit a populated .env file.
ADMIN_PASSWORD_HASH=
SESSION_SECRET_KEY=
SESSION_HTTPS_ONLY=true

# Browser settings. Firefox ESR is the default target; install it separately.
BROWSER_NAME=firefox-esr
BROWSER_EXECUTABLE=
BROWSER_PROFILE_DIR=/var/lib/messenger-call-keeper/browser-profile
BROWSER_AUTO_RESTART=true
BROWSER_HEADLESS=false
DISPLAY=:99

# Persistent, private runtime data paths.
MCK_DATA_DIR=/var/lib/messenger-call-keeper
MCK_LOG_DIR=/var/log/messenger-call-keeper
